<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.expirelog.mapper.MemberOrderMapper">

    <resultMap id="BaseResultMap" type="com.expirelog.entity.MemberOrder">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="duration_days" property="durationDays"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectPaid" resultMap="BaseResultMap">
        SELECT id, user_id, duration_days, status, created_at
        FROM member_order
        WHERE id = #{orderId}
          AND status = 'PAID'
    </select>

    <insert id="insert">
        INSERT INTO member_order (id, user_id, duration_days, status, created_at)
        VALUES (#{id}, #{userId}, #{durationDays}, #{status}, #{createdAt})
    </insert>

</mapper>
